#
# ~/.bashrc
#

# If not running interactively, don't do anything
[[ $- != *i* ]] && return

alias ls='ls -F --color=auto'
alias grep='grep --color=auto'
alias tree='tree -C'
PS1='[\u@\h \W]\$ '

export PATH="$HOME/.local/bin:$PATH"
export EDITOR=/usr/bin/vim
export TERMINAL=terminator
export PAGER=less
export WM=i3

# Locations I use

export WINEPREFIX="$HOME/.wine"
export C="$WINEPREFIX/drive_c/"
export TELEGRAM_DESKTOP="$HOME/Downloads/Telegram Desktop/"

# Personalized aliases

alias edit='$EDITOR $1'
alias open=xdg-open
alias summon=i3-summon
alias hh="vim + ~/.zsh_history"
alias pp="uv version --bump"
alias tt=taskwarrior-tui
alias vv='source .venv/bin/activate'

# My shell functions

rr() {
    file=/tmp/rr
    ranger --choosedir=$file $*
    dir=$(cat $file)
    cd $dir
    rm $file
}
pcurlloop() {
    while true
    do
        date
        pcurl -s
        echo
        sleep ${1:-6}
    done
}
orphans(){
    for pack in $(pacman -Qdtq)
    do
        pacman -Ss "^$pack$"
    done
}
showpack() {
    pamac info $1 | rg "Required|Optional|Depends"
}

# vim: ft=sh
