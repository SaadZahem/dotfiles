source $VIMRUNTIME/defaults.vim
syntax on
filetype plugin indent on

set expandtab
set tabstop=4
set shiftwidth=4
set softtabstop=4

" 'Just kidding' is the best way to escape insertion mode
imap jk <Esc>

" Rerender the buffer without losing the current position
let @r = "m0GVgg0\<Esc>'0"

" Map Ctrl+C in visual mode to copy exact selection to system clipboard
vnoremap <C-c> y:call system("xclip -selection clipboard", @")<CR>

" Function to compile SILE and handle errors
function! CompileSile()
  let l:dir = shellescape(expand('%:p:h'))
  let l:file = shellescape(expand('%:t'))

  let l:cmd = 'cd ' . l:dir . ' && env -u LUA_PATH -u LUA_CPATH -u LUA_INIT sile ' . l:file
  let l:output = system(l:cmd)

  if v:shell_error != 0
    echo "SILE Compilation Failed:\n" . l:output
  endif
endfunction

" Automatically compile SILE documents on save in a clean environment
augroup SileCompile
  autocmd!
  autocmd BufWritePost *.sil call CompileSile()
augroup END
