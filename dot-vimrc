source $VIMRUNTIME/defaults.vim
syntax on
filetype plugin indent on

" Settings for sile, synctex, and latex
runtime typesetting.vim

" set et ts=4 sw=4 sts=4
set expandtab
set tabstop=4
set shiftwidth=4
set softtabstop=4

" GVim options
if has('gui_running')
    set guioptions-=m  " Hide menu bar
    set guioptions-=T  " Hide toolbar
    set guioptions-=r  " Hide left scrollbar
    set guioptions-=L  " Hide left scrollbar
    set guifont=JetBrains\ Mono\ 11
    colorscheme habamax

    set nu rnu
endif

" 'Just kidding' is the best way to escape insertion mode
" Added kj because I mistype a lot
imap jk <Esc>
imap kj <Esc>

" Rerender the buffer without losing the current position
let @r = "m0GVgg0\<Esc>'0"

" Map Ctrl+C in visual mode to copy exact selection to system clipboard
vnoremap <C-c> y:call system("xclip -selection clipboard", @")<CR>
