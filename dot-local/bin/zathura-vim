#!/usr/bin/env sh

FILE="$1"
PAGE="$2"
BASEDIR="$HOME/.local/share/zathura/vimnotes"

# Hashing to escape dealing with whitespaces and long file path
HASH=$(echo -n "$FILE" | sha256sum | awk '{print $1}')

# Deciding the name of the file
if [[ -n "$PAGE" ]]; then
    NAME="$PAGE"
else
    # Normalizing the filename
    #
    # Remove file location, extension, whitespaces, and ampersand
    # Keeping the '&' in the file name causes an error
    NAME=$(basename "$FILE" .pdf | tr -d '[:space:]&')
fi

mkdir -p "$BASEDIR/$HASH"
TARGET="$BASEDIR/$HASH/$NAME.md"

# Giving the terminal the title "VimPad" makes it floating and big
i3-sensible-terminal -T VimPad -x vim "$TARGET"
