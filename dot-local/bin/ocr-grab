#!/usr/bin/env sh

TMP_IMG=$(mktemp /tmp/ocr-XXXXXX.png)
trap 'rm -f "$TMP_IMG"' EXIT

# 1. Detect current active keyboard layout
LANG_CODE=$(setxkbmap -query 2>/dev/null | grep -E '^layout:' | grep -iq "ara" && echo "ara")

# 2. Capture selected screen area
maim -s "$TMP_IMG" || exit 1

# 3. Run OCR with the detected language
# Use ara+eng when layout is Arabic to catch mixed Latin terms/numbers
if [ "$LANG_CODE" = "ara" ]; then
    TESS_LANG="ara+eng"
else
    TESS_LANG="eng"
fi

TEXT=$(tesseract "$TMP_IMG" stdout -l "$TESS_LANG" --oem 1 --psm 6 2>/dev/null)

# Clean up whitespace
TEXT=$(echo "$TEXT" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')

# 4. Copy to clipboard and notify
if [ -n "$TEXT" ]; then
    echo -n "$TEXT" | xclip -selection clipboard
    notify-send "OCR Copied [$TESS_LANG]" "$TEXT" -t 3000
else
    notify-send "OCR Failed" "No text recognized" -t 2000
fi
