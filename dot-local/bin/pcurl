#!/usr/bin/env bash

INTERFACE=wlp1s0
PCURLRC=~/.config/pcurlrc

ssid=$(iw dev "$INTERFACE" link | grep 'SSID' | awk '{$1=""; print $0}' | xargs)
contents=$(jaq -c --from yaml < "$PCURLRC" .)
settings=$(jaq -c <<< "$contents" ".local[.ssid[\"$ssid\"]]")

if [[ "$settings" == "null" ]]
then
    echo "pcurl: couldn't find suitable settings for '$ssid'" >&2
    exit 1
fi

for attr in domain port zone email pword
do
    export $attr=$(jaq -r <<< "$settings"  ".$attr")
    [[ "${!attr}" == "null" ]] && export $attr=$(jaq -r <<< "$contents" ".global.$attr")
done

export extra=$@
echo curl $(jaq -r --from yaml < "$PCURLRC" .curl) | envsubst
