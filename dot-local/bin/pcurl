#!/usr/bin/env sh

default_interface=$(iw dev | grep Interface | awk '{print $2}' | head -n1)
INTERFACE=${INTERFACE:-$default_interface}
PCURLRC=${PCURLRC:-~/.config/pcurlrc}

ssid=$(iw dev "$INTERFACE" link | grep 'SSID' | awk '{$1=""; print $0}' | xargs)

if [[ -z "$ssid" ]]
then
    echo "pcurl: you're disconnected" >&2
    exit 1
fi

contents=$(jaq -c --from yaml < "$PCURLRC" .)
settings=$(jaq -c <<< "$contents" ".local[.ssid[\"$ssid\"]]")

if [[ "$settings" == "null" ]]
then
    echo "pcurl: couldn't find suitable settings for '$ssid'" >&2
    exit 2
fi

for attr in domain port zone email pword
do
    [[ -z "${!attr}" ]] && export $attr=$(jaq -r <<< "$settings"  ".$attr")
    [[ "${!attr}" == "null" ]] && export $attr=$(jaq -r <<< "$contents" ".global.$attr")
done

export extra=$@
cmd=$(echo curl $(jaq -r --from yaml < "$PCURLRC" .curl) | envsubst)

# env dry=1 pcurl: prints the command without executing it
if [[ -n "$dry" ]]
then
    echo $cmd
else
    exec sh -c "$cmd"
fi
