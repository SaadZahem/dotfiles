#!/usr/bin/env sh

INTERFACE="${INTERFACE:-$(ip r | awk '/default/ {print $5}' | head -1)}"
PCURLRC=${PCURLRC:-~/.config/pcurlrc}

ssid=$(iw dev "$INTERFACE" link | grep 'SSID' | awk '{$1=""; print $0}' | xargs)

if [[ -z "$ssid" ]]
then
    echo "pcurl: you're disconnected" >&2
    exit 1
fi

contents=$(jaq -c --from yaml < "$PCURLRC" .)
settings=$(jaq -c <<< "$contents" ".local[.ssid[\"$ssid\"]]")

if [[ "$settings" == "null" ]]
then
    echo "pcurl: couldn't find suitable settings for '$ssid'" >&2
    exit 2
fi

for attr in domain port zone email pword
do
    if [[ -z "${!attr}" ]]; then
        # read value from local settings
        value=$(jaq -c <<< "$settings" ".$attr")
        if [[ "$value" == "null" ]]; then
            # fallback to global settings
            export $attr=$(jaq -r <<< "$contents" ".global.$attr")
        else
            # remove quotes around string values
            export $attr=$(echo $value | jaq -r)
        fi
    fi
done

export extra=$@
cmd=$(echo curl $(jaq -r --from yaml < "$PCURLRC" .curl) | envsubst)

# env dry=1 pcurl: prints the command without executing it
if [[ -n "$dry" ]]
then
    echo $cmd
else
    exec sh -c "$cmd"
fi
