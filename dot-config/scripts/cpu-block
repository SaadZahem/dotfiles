#!/usr/bin/env sh

# Get first snapshot
read -r _ u1 n1 s1 i1 io1 ir1 sir1 st1 g1 gn1 < /proc/stat
prev_idle=$((i1 + io1))
prev_total=$((u1 + n1 + s1 + i1 + io1 + ir1 + sir1 + st1))

sleep 0.5

# Get second snapshot
read -r _ u2 n2 s2 i2 io2 ir2 sir2 st2 g2 gn2 < /proc/stat
idle=$((i2 + io2))
total=$((u2 + n2 + s2 + i2 + io2 + ir2 + sir2 + st2))

# Calculate using awk to handle decimals correctly
usage=$(awk -v pi="$prev_idle" -v pt="$prev_total" -v ni="$idle" -v nt="$total" \
    'BEGIN {
        diff_idle = ni - pi;
        diff_total = nt - pt;
        if (diff_total == 0) print "0.00";
        else printf "%.2f", (1 - diff_idle / diff_total) * 100
    }')

echo "$usage%"
