#!/usr/bin/env sh

BAT="${BAT:-/sys/class/power_supply/BAT0}"
CAPACITY=$(cat "$BAT/capacity")
STATUS=$(cat "$BAT/status")
FULL=$(cat "$BAT/energy_full")
FULL_DESIGN=$(cat "$BAT/energy_full_design")
CYCLE_COUNT=$(cat "$BAT/cycle_count")

STATE_FILE="${STATE_FILE:-$HOME/.local/state/battery_notified}"
mkdir -p "${STATE_FILE%/*}"
trap 'rm -f "$STATE_FILE"' EXIT

# Battery Status Icon
case "$STATUS" in
    (Charging)      ICON="⚡" ;;
    (Discharging)   ICON=""  ;;
    (Full)          ICON="🔌" ;;
    (*)             ICON="🔋" ;;
esac

# Battery Health
HEALTH_PCT=$(awk -v f="$FULL" -v fd="$FULL_DESIGN" 'BEGIN { printf "%.2f", (f / fd) * 100 }')

# Full and short text
echo "$ICON $CAPACITY% $HEALTH_PCT% ($CYCLE_COUNT)"
echo "$ICON $CAPACITY%"

# Battery Recharge Reminder
if [[ "$CAPACITY" -le 20 && "$STATUS" == "Discharging" ]]
then
    if [[ ! -f "$STATE_FILE" ]]
    then
        touch "$STATE_FILE"
        notify-send -u critical "Battery Low"\
            "Plug in your charger! Capacity at ${CAPACITY}%."
    fi
    echo "#FFFFFF"
    exit 33  # urgent exit code, this sets the background to red
fi
