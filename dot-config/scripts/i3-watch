#!/usr/bin/env python3
import i3ipc

i3 = i3ipc.Connection()

# Track the last active mode (fallback to "default")
previous_mode = "default"
current_mode = "default"
auto_claw = False


def on_mode_change(i3, event):
    global previous_mode, current_mode
    mode = event.change

    if mode != current_mode:
        previous_mode = current_mode
        current_mode = mode


def on_window_focus(i3, event):
    global current_mode, previous_mode, auto_claw
    focused = event.container
    window_class = (focused.window_class or "").lower()

    # if focus is taken away from claw.exe, exit from claw mode
    if window_class == "claw.exe" and auto_claw:
        i3.command("mode claw")
    else:
        if current_mode == "claw":
            i3.command(f'mode "{previous_mode}"')
            auto_claw = True
        else:
            auto_claw = False


# Subscribe to both mode updates and window focus events
i3.on("mode", on_mode_change)
i3.on("window::focus", on_window_focus)

i3.main()
