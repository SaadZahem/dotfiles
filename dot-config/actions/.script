#!/bin/sh
#
# This is the macro I used
# jiecho '€ý5A' > "€ý5kv0dj$pa"€ý5jj0

echo "i3 exit" > "exit i3"
echo "i3 reload" > "reload i3"
echo "i3 restart" > "restart i3"
echo 'shutdown now' > "shutdown now"
echo 'systemctl reboot' > "reboot"
echo 'systemctl poweroff' > "poweroff"
echo '~/.config/scripts/lock' > "lock screen"
echo 'i3-resurrect restore -w 3' > "restore w3"
echo 'notify-send "xprop" "$(xprop | grep WM_CLASS)"' > "xprop class"
